# Clerk — https://dashboard.clerk.com
# Local/preview: pk_test_… + sk_test_…
# Production: pk_live_… + sk_live_… on a custom domain (not *.vercel.app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Neon / Postgres — https://console.neon.tech
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Products → Prices in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# App URL — production must be the HTTPS custom domain configured in Clerk
# Used for Checkout success/cancel + Portal return
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Weekly digest email — https://resend.com
# Without these the digest cron reports every send as skipped, so preview and
# development runs cannot mail real people.
RESEND_API_KEY=re_...
EMAIL_FROM="Vibe / Ops <hello@yourdomain.com>"

# Shared secret for /api/cron/*. Generate with: openssl rand -hex 32
# The cron route refuses to run at all when this is unset.
CRON_SECRET=
