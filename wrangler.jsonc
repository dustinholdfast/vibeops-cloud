{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibeops-cloud",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-04",

  /**
   * `nodejs_compat` is required, not optional. It provides the TCP sockets
   * postgres.js needs, and it populates `process.env` from the vars and
   * secrets below — which is where every server module reads configuration
   * from. Verified locally: with DATABASE_URL set as a var, /api/health
   * reports hasDatabase true.
   */
  /**
   * `global_fetch_strictly_public` is required for uptime probes. Without it,
   * Worker fetch() to same-account *.workers.dev / *.pages.dev is routed to
   * the zone origin (often empty) and returns a silent HTTP 404 — while the
   * same URL returns 200 from a laptop. With the flag, fetch goes through
   * Cloudflare's public front door like a normal internet request.
   */
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  /**
   * Custom domains. workers.dev stays up as rollback. Wrangler disables it
   * whenever `routes` exist unless this is explicit.
   */
  "workers_dev": true,
  "routes": [
    { "pattern": "noxencloud.com", "custom_domain": true },
    { "pattern": "www.noxencloud.com", "custom_domain": true }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  /**
   * Loopback so uptime can probe this Worker without going out through
   * workers.dev and back. Even with global_fetch_strictly_public, a Worker
   * fetching its own hostname is a loop Cloudflare may 404 / 1019.
   */
  "services": [
    {
      "binding": "SELF",
      "service": "vibeops-cloud"
    }
  ],

  /**
   * Configuration lives in secrets, not here, so nothing environment-specific
   * is committed. Set each with `npx wrangler secret put <NAME>`:
   *
   *   DATABASE_URL                        Neon's POOLED endpoint (see below)
   *   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY   also needed at build time
   *   CLERK_SECRET_KEY
   *   STRIPE_SECRET_KEY
   *   STRIPE_WEBHOOK_SECRET
   *   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  also needed at build time
   *   STRIPE_PRICE_PRO_MONTHLY
   *   STRIPE_PRICE_PRO_YEARLY
   *   NEXT_PUBLIC_APP_URL                 also needed at build time
   *   RESEND_API_KEY
   *   EMAIL_FROM
   *   CRON_SECRET
   *   ADMIN_USER_IDS / ADMIN_EMAILS
   *   GEMINI_API_KEY                      workspace copilot (Gemini 3.6 Flash)
   *
   * NEXT_PUBLIC_* values are inlined by Next at build time, so they must be
   * present in the build environment as well as set as secrets — a secret
   * alone will not reach client bundles.
   *
   * DATABASE_URL must be Neon's pooled endpoint, the host containing
   * `-pooler`. Each Workers isolate opens its own connection, and the direct
   * endpoint's limit would be exhausted well before traffic justified it.
   * `prepare: false` is already set in src/db/index.ts, which is what makes a
   * transaction-mode pooler safe here.
   */


  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6d0f23a68d4444bd841520d92fb2851e",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
